# === Required ===
OPENAI_API_KEY=sk-your-api-key-here
# Fernet key that encrypts stored provider API keys. Generate once and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Local development generates one on first use; prod scope (docker compose) refuses to start without it.
BOOK_AGENT_SECRET_KEY=

# === LLM Provider (any OpenAI-compatible endpoint) ===
# NVIDIA Integrate API (default). Swap base_url+model for other OpenAI-compatible providers.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
BOOK_AGENT_TRANSLATION_BACKEND=openai_compatible
BOOK_AGENT_TRANSLATION_MODEL=deepseek-ai/deepseek-v3.1-terminus

# === Database (PostgreSQL) ===
# `./dev.sh` local development uses Docker Compose PostgreSQL on 55432.
BOOK_AGENT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/book_agent

# === Scope ===
# dev (default) allows the echo backend and generates a missing secret key;
# prod refuses both. docker compose sets prod.
# BOOK_AGENT_APP_SCOPE=dev

# === Artifact roots (uploads, exports, blobs, parse IR, images live under artifacts/) ===
# BOOK_AGENT_EXPORT_ROOT=artifacts/exports
# BOOK_AGENT_UPLOAD_ROOT=artifacts/uploads

# === Timeout & Retry ===
BOOK_AGENT_TRANSLATION_TIMEOUT_SECONDS=120
BOOK_AGENT_TRANSLATION_MAX_RETRIES=2
BOOK_AGENT_TRANSLATION_RETRY_BACKOFF_SECONDS=2.0

# === CORS (frontend dev servers) ===
BOOK_AGENT_CORS_ALLOW_ORIGINS=http://localhost:4173,http://localhost:5173

# --- Access control (required in prod scope) ---
# disabled | api_key. With api_key every API call except /v1/health and /v1/meta needs
# "Authorization: Bearer <key>"; create the first key with book-agent create-api-key.
BOOK_AGENT_AUTH_MODE=disabled
# Extra server directories POST /v1/documents/bootstrap may read (comma-separated; uploads are always allowed).
BOOK_AGENT_BOOTSTRAP_SOURCE_ROOTS=
# Allow provider base URLs on private networks (self-hosted models) when auth is on or in prod.
BOOK_AGENT_PROVIDER_ALLOW_PRIVATE_HOSTS=false

# --- Metrics ---
# Bearer token Prometheus sends to GET /metrics. Unset: an admin API key is required when auth is on.
BOOK_AGENT_METRICS_TOKEN=

# --- Traces ---
# OpenTelemetry traces (install book-agent[otel]; the Docker image includes it). The exporter reads the
# standard variables, e.g. OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318 and OTEL_SERVICE_NAME.
BOOK_AGENT_OTEL_TRACES_ENABLED=false

# --- Multi-instance ---
# false on API-only replicas; replicas with the executor share runs through per-run ownership leases.
BOOK_AGENT_RUN_EXECUTOR_ENABLED=true
# Seconds an executor instance keeps a run after it stops renewing (renewed every poll).
BOOK_AGENT_RUN_OWNERSHIP_TTL_SECONDS=30
