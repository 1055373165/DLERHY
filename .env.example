# === Required ===
OPENAI_API_KEY=sk-your-api-key-here
# Fernet key that encrypts stored provider API keys. Generate once and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Local development generates one on first use; prod scope (docker compose) refuses to start without it.
BOOK_AGENT_SECRET_KEY=

# === LLM Provider (any OpenAI-compatible endpoint) ===
# NVIDIA Integrate API (default). Swap base_url+model for other OpenAI-compatible providers.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
BOOK_AGENT_TRANSLATION_BACKEND=openai_compatible
BOOK_AGENT_TRANSLATION_MODEL=deepseek-ai/deepseek-v3.1-terminus

# === Database (PostgreSQL) ===
# `./dev.sh` local development uses Docker Compose PostgreSQL on 55432.
BOOK_AGENT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/book_agent

# === Scope ===
# dev (default) allows the echo backend and generates a missing secret key;
# prod refuses both. docker compose sets prod.
# BOOK_AGENT_APP_SCOPE=dev

# === Artifact roots (uploads, exports, blobs, parse IR, images live under artifacts/) ===
# BOOK_AGENT_EXPORT_ROOT=artifacts/exports
# BOOK_AGENT_UPLOAD_ROOT=artifacts/uploads

# === Timeout & Retry ===
BOOK_AGENT_TRANSLATION_TIMEOUT_SECONDS=120
BOOK_AGENT_TRANSLATION_MAX_RETRIES=2
BOOK_AGENT_TRANSLATION_RETRY_BACKOFF_SECONDS=2.0

# === CORS (frontend dev servers) ===
BOOK_AGENT_CORS_ALLOW_ORIGINS=http://localhost:4173,http://localhost:5173
